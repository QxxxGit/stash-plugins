{
	"name": "qx-file-browser",
	"version": "0.1",
	"main": "qxFileBrowser.tsx",
	"license": "MIT",
	"scripts": {
		"build": "yarn run format && esbuild src/qxFileBrowser.tsx --bundle --outfile=dist/qxFileBrowser.js && yarn run sass && yarn run copy",
		"copy": "yarn run copy:yml",
		"copy:yml": "cpx \"src/qxFileBrowser.yml\" \"dist\"",
		"format": "prettier --write .",
		"sass": "sass --no-source-map --style=expanded src/qxFileBrowser.scss:dist/qxFileBrowser.css"
	},
	"devDependencies": {
		"@types/react": "18.2.48",
		"@types/react-dom": "18.2.18",
		"cpx": "1.5.0",
		"esbuild": "0.20.0",
		"prettier": "3.5.3",
		"sass": "1.71.1",
		"ts-loader": "9.5.1",
		"typescript": "5.3.3"
	},
	"dependencies": {}
}
